ECOCOACH_ENVIRONMENT=development
ECOCOACH_API_PREFIX=/api
ECOCOACH_DEFAULT_FACTOR_SET=india-demo-2025.1
ECOCOACH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Backend Firebase Service Account (JSON file path)
ECOCOACH_FIREBASE_SERVICE_ACCOUNT=C:/path/to/your/firebase-service-account.json

# Frontend Firebase Client Credentials (put these in frontend/.env)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

